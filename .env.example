# Copy to .env.development.local for local development.
#
# Phase 1 ONLY: credentials for the development mock admin login.
# These are fake, local-only values. The mock login is disabled in production
# builds; real admin accounts are provisioned in Supabase Auth in Phase 2.
VITE_MOCK_ADMIN_EMAIL=admin@example.test
VITE_MOCK_ADMIN_PASSWORD=dev-only-change-me

# Phase 2 — put real values in .env.local (never committed). When both are set the
# app uses Supabase instead of demo data. Only the PUBLIC anon/publishable key
# belongs here; never the service-role key. See docs/SUPABASE_SETUP.md.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=
# VITE_DATA_SOURCE=mock   # optional: force demo data
